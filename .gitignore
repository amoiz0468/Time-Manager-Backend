# The directory Mix will write compiled artifacts to.
/_build/

# Ignore dependencies
/deps/

# Ignore Elixir language server
/.elixir_ls/

# Ignore VSCode and JetBrains IDE settings
/.vscode/
/.idea/

# Ignore environment and secret files
.env
.env.*
*.secret

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore editor swap and backup files
*.swp
*.swo
*.bak
*.tmp
*.log
*.orig
*.rej
*.patch
*.pid
*.seed
*.old
*.out
*.cache
*.pid.lock

# Ignore test and coverage artifacts
/cover/
/test/tmp/

# Ignore compiled files
*.beam
*.ez
*.plt
*.plts
*.dump
*.tar
*.tar.gz
*.zip
*.db
*.sqlite3

# Ignore code workspace and project files
*.code-workspace
*.sublime*
*.iml

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
time_manager_api-*.tar

# Ignore node_modules if present
node_modules/

